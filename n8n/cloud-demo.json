{
  "id": "aowCloudDemo0001",
  "name": "AI Operator Weekly - Cloud collect (GitHub Actions → Airtable)",
  "active": false,
  "settings": {
    "timezone": "America/New_York",
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "executionTimeout": 175
  },
  "nodes": [
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c001",
      "parameters": {},
      "name": "Start demo (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c002",
      "parameters": {
        "jsCode": "// Runs started after this moment belong to this execution.\nreturn [{ json: { started_at: new Date(Date.now() - 10000).toISOString(), repo: 'mtesfaye-png/ai-operator-weekly', workflow_file: 'rss-collect.yml' } }];"
      },
      "name": "Remember start time",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c003",
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/mtesfaye-png/ai-operator-weekly/actions/workflows/rss-collect.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"ref\": \"main\", \"inputs\": { \"days\": \"3\", \"max_sync\": \"15\", \"started_by\": \"n8n-cloud\" } }",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Start GitHub Actions collect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "aowGitHubToken01",
          "name": "GitHub Actions token"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c004",
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      },
      "name": "Wait 15 seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "webhookId": "0c1d0a52-0b7e-4b9e-9d0a-00000000cw01"
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c005",
      "parameters": {
        "url": "https://api.github.com/repos/mtesfaye-png/ai-operator-weekly/actions/workflows/rss-collect.yml/runs?event=workflow_dispatch&per_page=5",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Check run status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "aowGitHubToken01",
          "name": "GitHub Actions token"
        }
      }
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c006",
      "parameters": {
        "jsCode": "// Picks the run this execution started (created after 'Remember start time') and reports its state.\nconst started = $('Remember start time').first().json.started_at;\nconst runs = $input.first().json.workflow_runs || [];\nconst run = runs.filter((r) => r.created_at >= started).sort((a, b) => a.created_at.localeCompare(b.created_at))[0];\nconst attempt = $runIndex + 1;\nreturn [{ json: {\n  found: !!run,\n  status: run ? run.status : 'not_started_yet',\n  conclusion: run ? run.conclusion : null,\n  run_url: run ? run.html_url : null,\n  run_id: run ? run.id : null,\n  attempt,\n  gave_up: attempt >= 9 && !(run && run.status === 'completed'),\n} }];"
      },
      "name": "Find our run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c007",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        0
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c008",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d2",
              "leftValue": "={{ $json.gave_up }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Waited too long?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        160
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c009",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d3",
              "leftValue": "={{ $json.conclusion }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Run succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        -120
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c010",
      "parameters": {
        "url": "https://api.airtable.com/v0/appYiy5hPq7BNDosa/Articles?pageSize=10&sort%5B0%5D%5Bfield%5D=first_seen_at&sort%5B0%5D%5Bdirection%5D=desc&fields%5B%5D=title&fields%5B%5D=source&fields%5B%5D=published_date&fields%5B%5D=first_seen_at&fields%5B%5D=url&fields%5B%5D=verification_status",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "options": {
          "timeout": 30000
        }
      },
      "name": "Read newest articles from Airtable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -220
      ],
      "credentials": {
        "airtableTokenApi": {
          "id": "aowAirtableRead1",
          "name": "Airtable (read)"
        }
      }
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c011",
      "parameters": {
        "jsCode": "// One row per article, newest first, with the GitHub run that collected them.\nconst run = $('Find our run').last().json;\nconst records = $input.first().json.records || [];\nreturn records.map((r) => ({ json: {\n  title: r.fields.title,\n  source: r.fields.source,\n  published: r.fields.published_date,\n  added_to_airtable: r.fields.first_seen_at,\n  verification: r.fields.verification_status,\n  url: r.fields.url,\n  github_run: run.run_url,\n} }));"
      },
      "name": "Newest articles (result)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -220
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c012",
      "parameters": {
        "errorMessage": "={{ 'GitHub Actions run finished as ' + $json.conclusion + '. Open it: ' + $json.run_url }}"
      },
      "name": "Run failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1760,
        -40
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c013",
      "parameters": {
        "errorMessage": "={{ 'The GitHub Actions run did not finish within about 2.5 minutes (n8n Cloud trial executions stop at 180 s). Check the Actions tab' + ($json.run_url ? ': ' + $json.run_url : '.') }}"
      },
      "name": "Timed out",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1760,
        260
      ]
    },
    {
      "id": "0c1d0a52-0b7e-4b9e-9d0a-00000000c014",
      "parameters": {
        "errorMessage": "={{ 'GitHub refused to start the run: ' + ($json.error && ($json.error.message || $json.error) || 'unknown error') + '. Check the GitHub Actions token credential (Actions: read and write on mtesfaye-png/ai-operator-weekly).' }}"
      },
      "name": "Could not start run",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        660,
        200
      ]
    }
  ],
