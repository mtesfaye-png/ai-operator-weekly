{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScoutOutput",
  "type": "object",
  "required": [
    "window_start",
    "window_end",
    "stories"
  ],
  "properties": {
    "window_start": {
      "type": "string",
      "format": "date"
    },
    "window_end": {
      "type": "string",
      "format": "date"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "story_id",
          "headline",
          "event_date",
          "category",
          "companies",
          "primary_url",
          "supporting_urls",
          "factual_summary",
          "why_it_might_matter",
          "pricing_change",
          "scores",
          "confidence",
          "unresolved_questions"
        ],
        "properties": {
          "story_id": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
          },
          "headline": {
            "type": "string",
            "minLength": 5
          },
          "event_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "category": {
            "enum": [
              "frontier_models",
              "tools",
              "enterprise",
              "business",
              "regulation",
              "open_source",
              "workflow",
              "infrastructure"
            ]
          },
          "companies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "primary_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "supporting_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          },
          "factual_summary": {
            "type": "string"
          },
          "why_it_might_matter": {
            "type": "string"
          },
          "pricing_change": {
            "type": "boolean"
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "importance",
              "usefulness",
              "business_value",
              "novelty",
              "audience_fit"
            ],
            "properties": {
              "importance": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "usefulness": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "business_value": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "novelty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "audience_fit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "unresolved_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}