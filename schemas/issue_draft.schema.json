{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueDraft",
  "type": "object",
  "required": [
    "subject_options",
    "preview_text",
    "sections",
    "claims_used",
    "word_count"
  ],
  "properties": {
    "subject_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 90
      }
    },
    "preview_text": {
      "type": "string",
      "maxLength": 150
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "markdown"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          },
          "story_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "claims_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "word_count": {
      "type": "integer"
    }
  }
}