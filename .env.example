# Copy to .env (never commit it) or set these as secrets on your server / in n8n.

# Required for daily + weekly runs
ANTHROPIC_API_KEY=

# Airtable (optional: without these, data is stored in ./data as JSON files)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Only for `npm run airtable:setup`
AIRTABLE_WORKSPACE_ID=

# beehiiv (optional: without these, each issue is exported for manual paste)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_POST_TEMPLATE_ID=

# Alerts (optional: without it, alerts print to stderr)
SLACK_WEBHOOK_URL=

# Trigger server for n8n (required if you run src/server.js)
AOW_TRIGGER_TOKEN=
PORT=8787

# Optional overrides
# Lower (never raise) the per-run dollar cap from config/runtime.json, e.g. for a first live test:
# AOW_MAX_USD=1
AOW_TIMEZONE=America/New_York
# AOW_DATA_DIR=/var/lib/aow/data
# AOW_OUT_DIR=/var/lib/aow/out
